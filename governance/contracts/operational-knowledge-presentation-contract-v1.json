{
  "contractId": "ATLAS-OPERATIONAL-KNOWLEDGE-PRESENTATION-CONTRACT-V1",
  "version": "1.0.0",
  "status": "FROZEN_P1_CONTRACT",
  "architecture": "ATLAS-DAUGHTER-EXECUTION-DEPTH-PRESENTATION-ARCHITECTURE-V1",
  "canonicalSemanticsChanged": false,
  "purpose": "Define how canonical Operational Knowledge is projected to each audience without making the renderer a second source of truth or exposing protected execution/client IP.",
  "defaultPolicy": "DENY_UNLESS_EXPLICITLY_ALLOWED",
  "renderingPrinciples": [
    "Operational Knowledge is a human-readable projection of governed canonical records.",
    "Public and general authenticated projections use positive allowlists.",
    "Exact client mappings, local values, protected source lineage and runtime implementation details are never included in public payloads.",
    "Unknown and unresolved values remain explicit; the presentation layer must not infer or fabricate them.",
    "Presentation-only changes do not change daughter semantic versions.",
    "Field-level authorization is evaluated before payload delivery, not by hiding browser-delivered data."
  ],
  "audiences": [
    "ANONYMOUS_PUBLIC",
    "AUTHENTICATED_ATLAS_USER",
    "PILOT_USER",
    "CLIENT_WORKSPACE_USER",
    "ADMIN_GOVERNOR",
    "OWNER"
  ],
  "presentationClasses": {
    "PUBLIC_SAFE": "May be delivered to all audiences in approved human-readable form.",
    "AUTHENTICATED_SAFE": "May be delivered to authenticated audiences but not anonymous public.",
    "INTERNAL_PROTECTED": "May be delivered to authorized Pilot, Admin/Governor and Owner audiences; client users only where explicitly allowed.",
    "CLIENT_AUTHORIZED": "May be delivered only inside an authorized client workspace and to Admin/Governor/Owner with legitimate scope.",
    "ADMIN_ONLY": "May be delivered only to Admin/Governor and Owner.",
    "OWNER_ONLY": "May be delivered only to Owner.",
    "AGGREGATE_ONLY": "Only count/band/status summaries may be delivered; underlying items remain protected.",
    "MASKED": "A sanitized value may be delivered but the canonical/raw value remains protected.",
    "NOT_RENDERED": "Never rendered in that projection."
  },
  "provenancePolicy": {
    "public": {
      "allowed": ["evidenceStatus", "basisClass", "authorityClass", "coverageStatus"],
      "notAllowed": ["exactSourceId", "sourceUrl", "sourceVersion", "claimMapping", "claimBoundaryDetail", "researchNotes", "crosswalkLogic"]
    },
    "authenticatedAtlasUser": {
      "allowed": ["evidenceStatus", "basisClass", "authorityClass", "coverageStatus"],
      "notAllowed": ["exactSourceId", "sourceUrl", "sourceVersion", "claimMapping", "researchNotes", "crosswalkLogic"]
    },
    "pilot": {
      "allowed": ["exactSourceId", "sourceName", "sourceVersion", "claimMapping", "claimBoundaryDetail"],
      "notAllowed": ["restrictedLicensePayload", "ownerOnlyGovernanceNotes"]
    },
    "clientWorkspace": {
      "allowed": ["evidenceStatus", "basisClass", "authorityClass", "clientEvidenceRefs", "approvedSourceSummary"],
      "conditional": ["exactSourceId where workspace policy permits"]
    },
    "adminGovernorOwner": {
      "allowed": ["full governed provenance subject to source-license constraints"]
    }
  },
  "emptyUnresolvedPolicy": {
    "UNKNOWN": "Render as Unknown — evidence not established. Never infer a value.",
    "NOT_APPLICABLE": "Render as Not applicable in current governed context.",
    "CLIENT_BINDING_REQUIRED": "Render a dependency indicator; do not expose restricted mapping/value outside the authorized client workspace.",
    "SOURCE_RESOLUTION_REQUIRED": "Render as Reference research required for protected/internal audiences; public receives only an incompleteness indicator.",
    "PENDING_VALIDATION": "Render as Candidate / validation pending; never present as approved operational truth.",
    "EMPTY_OPTIONAL": "Do not render an empty card; preserve the canonical null state.",
    "CONFLICT": "Render Conflict / resolution required and expose only the conflict summary permitted by audience."
  },
