  "referenceConfigurations": [
    {
      "code": "A",
      "title": "Operating Carrier · Hub-and-Spoke · Cross-Dock",
      "status": "ENABLED",
      "summary": "Activates carrier responsibility, terminal specialization, consolidation and intermediate cross-dock emphasis.",
      "sources": [
        "src-gs1-epcis",
        "src-scor"
      ],
      "config": {
        "role": "carrier",
        "movement": "mp-hub-and-spoke",
        "node": "node-cross-dock"
      }
    },
    {
      "code": "B",
      "title": "Shipper · Direct Shipment",
      "status": "CONDITIONAL",
      "summary": "Permitted variant only when contracted service supports bypass of terminal consolidation/deconsolidation; the composer marks bypassed network records without deleting them from the LTL universe.",
      "sources": [
        "src-uncefact-rdm"
      ],
      "config": {
        "role": "shipper",
        "movement": "mp-direct-shipment"
      }
    },
    {
      "code": "C",
      "title": "3PL · Hub-and-Spoke · Finance lens",
      "status": "ENABLED",
      "summary": "Keeps one operating graph while shifting responsibility metadata and focusing preliminary charge, audit and settlement controls.",
      "sources": [
        "src-apqc-pcf",
        "src-dsdc-pfc"
      ],
      "config": {
        "role": "3pl",
        "movement": "mp-hub-and-spoke",
        "lens": "ecl-x"
      }
    },
    {
      "code": "D",
      "title": "United States · Dangerous Goods",
      "status": "CONDITIONAL",
      "summary": "Loads North-American LTL/classification context plus U.S. hazardous-material evidence because country scope is explicitly United States; commodity and provision-level applicability still require resolution.",
      "sources": [
        "src-nmfc",
        "src-49cfr177"
      ],
      "config": {
        "jurisdiction": "jur-united-states",
        "conditions": [
          "cond-dangerous-goods"
        ]
      }
    },
    {
      "code": "E",
      "title": "CMR scope · Dangerous Goods",
      "status": "CONDITIONAL",
      "summary": "CMR and dangerous-goods scope are resolved independently; ADR is not inferred merely from CMR.",
      "sources": [
        "src-cmr",
        "src-adr"
      ],
      "config": {
        "regimes": [
          "cr-cmr"
        ],
        "conditions": [
          "cond-dangerous-goods"
        ]
      }
    },
    {
      "code": "F",
      "title": "India · Dangerous Goods",
      "status": "RESEARCH REQUIRED",
      "summary": "E-way-bill evidence is available, but the complete current national/state dangerous-goods source pack is not frozen.",
      "sources": [
        "src-india-eway"
      ],
      "config": {
        "jurisdiction": "jur-india",
        "conditions": [
          "cond-dangerous-goods"
        ]
      }
    },
    {
      "code": "G",
      "title": "Temperature Controlled",
      "status": "CONDITIONAL",
      "summary": "Activates equipment/condition controls. ATP remains a candidate source and is not activated until specified goods and legal scope resolve.",
      "sources": [
        "src-atp"
      ],
      "config": {
        "conditions": [
          "cond-temperature-controlled"
        ]
      }
    },
    {
      "code": "H",
      "title": "Customs Transit",
      "status": "CONDITIONAL",
      "summary": "Activates regulatory status, hold/release and evidence. TIR remains a candidate source and is not inferred from customs-transit selection alone.",
      "sources": [
        "src-tir",
        "src-wco-dm"
      ],
      "config": {
        "conditions": [
          "cond-customs-transit"
        ]
      }
    },
    {
      "code": "I",
      "title": "Bonded context",
      "status": "CONDITIONAL",
      "summary": "Activates inventory/custody segregation and authority hold/release; national authorization remains required.",
      "sources": [
        "src-wco-dm"
      ],
      "config": {
        "conditions": [
          "cond-bonded"
        ],
        "node": "node-bonded-warehouse"
      }
    },
    {
      "code": "J",
      "title": "Multimodal / Intermodal relationship",
      "status": "CONDITIONAL",
      "summary": "Activates leg-by-leg interchange. Each non-road leg retains its carrier, document, regime and jurisdiction.",
      "sources": [
        "src-uncefact-rdm",
        "src-cmr"
      ],
      "config": {
        "movement": "mp-multimodal"
      }
    }
  ],
  "principle": "Reusable overlays are governed building blocks; user configurations do not create new taxonomy."
}