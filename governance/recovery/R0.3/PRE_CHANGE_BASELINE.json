  "findings": [
    {
      "id": "R0.3-A-01",
      "severity": "HIGH",
      "statement": "The governed 1.4 Operational Knowledge payload contains no canonical object or document references. Zero occurrences of canonicalObjectRef, inputObjectRefs, outputObjectRefs, canonicalObjectId, documentRef or objectId across all 22 tasks, while Operational Knowledge Contract v2 requires inputsOutputs object refs and treats objectSemantics as first-class reusable contracts. This is the objects/documents gap R0.3 is authorized to classify."
    },
    {
      "id": "R0.3-A-02",
      "severity": "MEDIUM",
      "statement": "The only researched canonical object model (TransportDocument/BOL with Consignment, HandlingUnits, LineItems, DangerousGoods, References, Parties, Instructions, ServiceEventWindows) sits in an asset classified DRAFT_RESEARCHED_NOT_PROMOTED and is scoped to LTL-03. It cannot be generalized to the other 21 tasks without new evidence."
    },
    {
      "id": "R0.3-A-03",
      "severity": "MEDIUM",
      "statement": "Operational Knowledge Contract v2 requires task-level applicability (requiredWhen, prohibitedWhen, jurisdictionIds, carriageRegimeIds, conditionIds), meaning (businessMeaning, why, businessOutcome, preconditions, postconditions) and authority (authorityOwner, sourceClaims, sourceBasis) at task level. The 1.4 payload carries 13 field families that do not include these task-level groups; coverage must therefore be measured, not assumed from field-family presence."
    },
    {
      "id": "R0.3-A-04",
      "severity": "MEDIUM",
      "statement": "The BOL baseline records 10 unresolved semantic labels (SOURCE_CONTEXT_PENDING or CLIENT_BINDING_REQUIRED). These must be preserved as explicit governed gaps; they must not be resolved by inference in R0.3."
    },
    {
      "id": "R0.3-A-05",
      "severity": "INFO",
      "statement": "All 14 in-scope inputs resolve on the governance branch at R0.2-certified hashes. Dependency closure for R0.3 is PASS with no implementation-branch-only or upload-only dependency."
    },
    {
      "id": "R0.3-A-06",
      "severity": "INFO",
      "statement": "reportedAccuracyMetric and reportedExtractionMetric in the BOL field performance baseline are runtime observations about a client extraction population. Under Operational Knowledge Contract v2 runtimeFeedback they may indicate gaps but cannot become canonical truth; R0.3 carries them as evidence only."
    }
