{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "kind",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "MISSING_COMPONENT",
        "MISSING_RELATIONSHIP",
        "MISSING_COMPATIBILITY_RULE",
        "INSUFFICIENT_EVIDENCE",
        "MISSING_A5_DETAIL"
      ]
    },
    "status": {
      "enum": [
        "OPEN",
        "RESEARCH_REQUIRED",
        "PROPOSED",
        "APPROVED",
        "REJECTED",
        "RESOLVED"
      ]
    },
    "context": {
      "type": "object"
    },
    "evidence": {
      "type": "array"
    }
  }
}