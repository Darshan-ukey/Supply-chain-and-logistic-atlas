{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/atlas-operational-semantic-record-v1.1.schema.json",
  "title": "Atlas v1.5 Operational Semantic Record — S8 governed compatibility",
  "description": "Bounded ATL-171 record compatible with the frozen Operational Knowledge v2 and Information Resolution v1 governance contracts without expanding ATL-171 into exhaustive field-level information resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "semanticRecordId",
    "moduleId",
    "moduleVersion",
    "processId",
    "stateBefore",
    "event",
    "decision",
    "rule",
    "control",
    "action",
    "evidence",
    "stateAfter",
    "outcome",
    "inputs",
    "outputs",
    "sourceIds",
    "knowledgeState",
    "dependencyClass",
    "relationships",
    "governingLineage"
  ],
  "properties": {
    "semanticRecordId": {
      "type": "string",
      "pattern": "^road-ltl::.+::operational-semantics::v1$"
    },
    "moduleId": {
      "const": "road-ltl"
    },
    "moduleVersion": {
      "const": "1.5"
    },
    "processId": {
      "type": "string",
      "minLength": 1
    },
    "stateBefore": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "control": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "stateAfter": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array"
    },
    "outputs": {
      "type": "array"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "knowledgeState": {
      "enum": [
        "KNOWN_AUTHORITATIVE",
        "KNOWN_CONDITIONAL",
        "KNOWN_SYNTHESIS",
        "UNKNOWN",
        "CONFLICTING",
        "NOT_APPLICABLE",
        "UNSUPPORTED"
      ]
    },
    "dependencyClass": {
      "enum": [
        "GENERIC_DOMAIN",
        "CLIENT_MASTER_REQUIRED",
        "EXTERNAL_AUTHORITY_REQUIRED",
        "UNRESOLVED"
      ]
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "targetId"
        ],
        "properties": {
          "type": {
            "enum": [
              "OBSERVES_EVENT",
              "CHANGES_STATE",
              "REQUIRES_DECISION",
              "EVALUATES_RULE",
              "OPERATES_CONTROL",
              "AUTHORIZES_ACTION",
              "GENERATES_EVIDENCE",
              "CONTRIBUTES_TO_OUTCOME"
            ]
          },
          "targetId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "governingLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseModule",
        "overlay",
        "operationalKnowledge",
        "operationalKnowledgeContract",
        "informationResolutionContract",
        "overrideApplied",
        "operationalKnowledgeRef"
      ],
      "properties": {
        "baseModule": {
          "const": "data/modules/road-ltl-v1.2.json"
        },
        "overlay": {
          "const": "data/modules/road-ltl-v1.5.json"
        },
        "operationalKnowledge": {
          "const": "data/operational-knowledge/road-ltl-v1.5-operational.json"
        },
        "operationalKnowledgeContract": {
          "const": "schemas/operational-knowledge-contract-v2.json"
        },
        "informationResolutionContract": {
          "const": "schemas/information-resolution-contract-v1.json"
        },
        "overrideApplied": {
          "type": "boolean"
        },
        "operationalKnowledgeRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
