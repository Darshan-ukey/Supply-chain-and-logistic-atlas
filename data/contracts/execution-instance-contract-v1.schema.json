{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-instance-contract-v1",
  "title": "Execution Instance / Leg Contract v1",
  "type": "object",
  "required": [
    "executionId",
    "referenceModuleId",
    "legs"
  ],
  "properties": {
    "executionId": {
      "type": "string"
    },
    "referenceModuleId": {
      "type": "string"
    },
    "atlasVersion": {
      "type": "string"
    },
    "context": {
      "type": "object"
    },
    "legs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "legId",
          "sequence",
          "modeOrService",
          "originNode",
          "destinationNode"
        ],
        "properties": {
          "legId": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "modeOrService": {
            "type": "string"
          },
          "originNode": {
            "type": "string"
          },
          "destinationNode": {
            "type": "string"
          },
          "operatorActorId": {
            "type": "string"
          },
          "jurisdictionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "carriageRegimeIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "equipmentObjectIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "schedule": {
            "type": "object"
          }
        }
      }
    }
  }
}
