{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/atlas-workdefinition-v1.schema.json",
  "title": "Atlas Canonical WorkDefinition v1 — S8 compiler/schema conformance",
  "description": "Schema boundary for S8-2E. Full canonical WorkDefinition instances compile only in S8-3 from EXECUTOR_READY terminal decomposition leaves under frozen contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workDefinitionId",
    "contractVersion",
    "version",
    "status",
    "title",
    "purpose",
    "lineage",
    "provenance",
    "executability"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "workDefinitionId": {
      "type": "string",
      "minLength": 1
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "lineage": {
      "type": "object",
      "required": [
        "daughterModule",
        "daughterVersion",
        "semanticSourceVersion",
        "inheritance",
        "sourceTaskId",
        "sourceTaskTitle",
        "decompositionId",
        "decompositionContractVersion",
        "sourceWorkUnitId",
        "workUnitPath",
        "unitType"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "compiledFrom",
        "compilerVersion",
        "governedInputContentHash",
        "sourceRefs"
      ],
      "properties": {
        "compiledFrom": {
          "const": "CANONICAL_WORK_DECOMPOSITION_V1"
        },
        "compilerVersion": {
          "type": "string"
        },
        "governedInputContentHash": {
          "type": "string"
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "executability": {
      "type": "object",
      "required": [
        "status",
        "executorClass",
        "independentExecutorProofStatus",
        "requiredClientBindings",
        "requiredKnowledgeGaps"
      ],
      "properties": {
        "status": {
          "const": "EXECUTOR_READY"
        },
        "independentExecutorProofStatus": {
          "const": "NOT_INDEPENDENTLY_PROVEN"
        },
        "requiredClientBindings": {
          "type": "array"
        },
        "requiredKnowledgeGaps": {
          "type": "array"
        }
      }
    },
    "applicability": {
      "type": "object"
    },
    "trigger": {},
    "inputs": {
      "type": "array"
    },
    "actors": {
      "type": "array"
    },
    "systems": {
      "type": "array"
    },
    "decisions": {
      "type": "array"
    },
    "rules": {
      "type": "array"
    },
    "validations": {
      "type": "array"
    },
    "controls": {
      "type": "array"
    },
    "actions": {
      "type": "array"
    },
    "outcomes": {
      "type": "array"
    },
    "transitions": {
      "type": "array"
    },
    "clocks": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "exceptions": {
      "type": "array"
    },
    "dependencies": {
      "type": "array"
    },
    "executionCharacteristics": {
      "type": "object"
    },
    "clientBindingRequirements": {
      "type": "array"
    }
  }
}
