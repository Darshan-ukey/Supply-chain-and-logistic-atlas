# Release
ATLAS_RELEASE_CHANNEL=lab
NODE_ENV=production

# Supabase (server-side Vercel Functions)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=   # optional compatibility fallback

# LLM gateway: none | gemini | openai | anthropic
ATLAS_LLM_PROVIDER=none
ATLAS_LLM_MODEL=
ATLAS_LLM_API_KEY=
# ATLAS_LLM_BASE_URL=
ATLAS_REQUIRE_LLM=false

# Pilot security
ATLAS_EPHEMERAL_DOCUMENTS=true
ATLAS_MAX_INLINE_DOCUMENT_BYTES=10485760
ATLAS_SESSION_TTL_MINUTES=30

# Optional release metadata
GIT_COMMIT=
