{
  "name": "@malkom/miniemail-react",
  "version": "0.1.0",
  "description": "React bindings for the Malkom Mini Email Engine — mounts a @malkom/miniemail-core panel inside React's lifecycle. Owns no behaviour.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tusharparikofficial/malkom-engines.git",
    "directory": "malkom-miniemail-engine/packages/react"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "peerDependencies": {
    "@malkom/miniemail-core": "^0.1.0",
    "react": ">=18"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -b"
  }
}
