{
  "name": "malkom-domainwarehouse-engine",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "generate": "node scripts/build-fixtures.mjs",
    "audit": "node scripts/audit.mjs",
    "compat": "node scripts/check-existing-engine-contracts.mjs",
    "build": "tsc -b packages/contract packages/core packages/react",
    "clean": "tsc -b --clean packages/contract packages/core packages/react",
    "test": "vitest run",
    "deep-audit": "node scripts/deep-runtime-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
