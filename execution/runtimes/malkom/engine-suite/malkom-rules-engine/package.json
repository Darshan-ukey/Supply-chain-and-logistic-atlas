{
  "name": "malkom-rulesengine",
  "private": true,
  "version": "0.1.0",
  "description": "Malkom Rules — a generic, metadata-aware business rules engine for queues and sub-queues. Embeddable, backend-agnostic, fully typed, small footprint.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/server packages/cli",
    "clean": "tsc -b --clean packages/core packages/server packages/cli",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
