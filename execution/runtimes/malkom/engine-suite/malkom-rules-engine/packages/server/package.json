{
  "name": "@malkom/rules-server",
  "version": "0.1.0",
  "description": "Malkom rules engine server shell: serves the core's web-standard fetch handler over node:http. No web framework, no dependencies beyond core.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "malkom-rules-server": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@malkom/rules-core": "*"
  }
}
