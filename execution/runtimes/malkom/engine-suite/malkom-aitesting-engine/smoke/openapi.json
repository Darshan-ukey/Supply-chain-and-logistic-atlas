{
  "openapi": "3.0.3",
  "info": {
    "title": "brisk-aitesting smoke contract",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Return service health",
        "tags": ["system"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "service"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "service": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/secure": {
      "get": {
        "operationId": "getSecureResource",
        "summary": "Reject anonymous secure requests",
        "tags": ["auth"],
        "responses": {
          "401": {
            "description": "Missing or invalid authorization",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": ["code", "message"],
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/messages": {
      "post": {
        "operationId": "publishMessage",
        "summary": "Publish a message",
        "tags": ["messaging"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["accepted", "id"],
                  "properties": {
                    "accepted": { "type": "boolean" },
                    "id": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid message"
          }
        }
      }
    }
  }
}
