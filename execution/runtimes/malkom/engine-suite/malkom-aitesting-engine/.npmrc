# Project-level override: the user's global ~/.npmrc sets legacy-peer-deps=true,
# which causes npm to skip recording peer deps (e.g. openapi-types) in
# package-lock.json. CI installs with default config and then fails with
# "Missing: X from lock file". This project resolves cleanly without the flag,
# so pin it to false here to keep the lockfile in sync with CI.
legacy-peer-deps=false
