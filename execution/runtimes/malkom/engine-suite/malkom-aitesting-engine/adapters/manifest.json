{
  "schemaVersion": "brisk-aitesting.adapter-manifest.v1",
  "adapters": [
    {
      "id": "schemathesis-openapi-fuzz",
      "name": "Schemathesis OpenAPI fuzz adapter",
      "status": "built",
      "runtime": "python-cli",
      "source": "src/schemathesis.ts",
      "runtimeExport": "SchemathesisOpenApiFuzzEngine",
      "typeExport": "SchemathesisEngineOptions",
      "smokeScript": "smoke:schemathesis",
      "coverageScript": "smoke:schemathesis",
      "smokeFile": "smoke/run-schemathesis-smoke.mjs",
      "workflow": ".github/workflows/schemathesis-smoke.yml",
      "referenceApp": "reference-apps/serious-saas",
      "conformance": "runEnginePluginConformance",
      "evidenceSchema": "brisk-aitesting.schemathesis-evidence.v1",
      "smokeSchema": "brisk-aitesting.schemathesis-smoke.v1",
      "optionalDependency": "schemathesis",
      "coverageMinimums": {
        "events": 20,
        "selectedOperations": 4,
        "successfulScenarios": 4,
        "artifacts": 5
      },
      "docs": [
        "README.md",
        "docs/ARCHITECTURE.md",
        "docs/STATUS.md",
        "docs/ROADMAP.md"
      ]
    },
    {
      "id": "specmatic-contract",
      "name": "Specmatic contract adapter",
      "status": "built",
      "runtime": "java-cli",
      "source": "src/specmatic.ts",
      "runtimeExport": "SpecmaticContractEngine",
      "typeExport": "SpecmaticEngineOptions",
      "smokeScript": "smoke:specmatic",
      "coverageScript": "smoke:specmatic",
      "smokeFile": "smoke/run-specmatic-smoke.mjs",
      "workflow": ".github/workflows/specmatic-smoke.yml",
      "referenceApp": "reference-apps/serious-saas",
      "conformance": "runEnginePluginConformance",
      "evidenceSchema": "brisk-aitesting.specmatic-evidence.v1",
      "smokeSchema": "brisk-aitesting.specmatic-smoke.v1",
      "optionalDependency": "specmatic",
      "coverageMinimums": {
        "events": 1,
        "selectedOperations": 1,
        "successfulScenarios": 1,
        "artifacts": 2
      },
      "docs": [
        "README.md",
        "docs/ARCHITECTURE.md",
        "docs/STATUS.md",
        "docs/ROADMAP.md"
      ]
    },
    {
      "id": "pact-message",
      "name": "Pact message adapter",
      "status": "built",
      "runtime": "node-library",
      "source": "src/pact.ts",
      "runtimeExport": "PactMessageEngine",
      "typeExport": "PactMessageEngineOptions",
      "smokeScript": "smoke:pact",
      "coverageScript": "smoke:pact",
      "smokeFile": "smoke/run-pact-smoke.mjs",
      "workflow": ".github/workflows/pact-smoke.yml",
      "referenceApp": "reference-apps/event-messaging",
      "conformance": "runEnginePluginConformance",
      "evidenceSchema": "brisk-aitesting.pact-message-evidence.v1",
      "smokeSchema": "brisk-aitesting.pact-message-smoke.v1",
      "optionalDependency": "@pact-foundation/pact",
      "coverageMinimums": {
        "events": 1,
        "selectedOperations": 1,
        "successfulScenarios": 1,
        "artifacts": 2
      },
      "docs": [
        "README.md",
        "docs/ARCHITECTURE.md",
        "docs/STATUS.md",
        "docs/ROADMAP.md"
      ]
    }
  ]
}
