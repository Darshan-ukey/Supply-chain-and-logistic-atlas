{
  "connections": [
    {
      "id": "ops",
      "dialect": "duckdb",
      "config": { "path": "examples/booking-ops.duckdb" }
    }
  ],
  "stream": {
    "id": "booking-ops",
    "name": "Booking operations",
    "defaultCaseObject": "booking",
    "bindings": [
      {
        "id": "work-events",
        "connectionRef": "ops",
        "table": { "name": "workEvents" },
        "grain": "interval",
        "roles": {
          "case": "queueId",
          "activity": ["subqueueId", "transactionStateId"],
          "resource": "allocatedTo",
          "start": "allocatedOn",
          "end": "completedOn",
          "duration": "aht"
        },
        "objects": [
          { "type": "booking", "column": "queueId" },
          { "type": "item", "column": "itemId" }
        ],
        "attributes": [{ "column": "aht", "as": "handlingSeconds" }]
      }
    ]
  }
}
