{
  "name": "@malkom/table-core",
  "version": "0.1.0",
  "description": "Malkom Table Engine core — config-driven Tabulator grid shell for the Malkom stack (Tailwind + Material Symbols Rounded). Zero runtime dependencies; Tabulator is a peer.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tusharparikofficial/malkom-engines.git",
    "directory": "malkom-table-engine/packages/core"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "peerDependencies": {
    "tabulator-tables": ">=5.5.0 <7"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -b"
  }
}
