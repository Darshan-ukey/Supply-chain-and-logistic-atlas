{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:execution:runtime-projection:v1",
  "title": "Atlas Runtime Projection V1",
  "type": "object",
  "required": ["projectionId", "adapterId", "runtime", "generatedFrom", "capabilityDispositions", "payload"],
  "properties": {
    "projectionId": {"type": "string"},
    "adapterId": {"type": "string"},
    "runtime": {"type": "string"},
    "generatedFrom": {
      "type": "object",
      "required": ["workDefinitionId", "workDefinitionVersion"],
      "properties": {
        "workDefinitionId": {"type": "string"},
        "workDefinitionVersion": {"type": "string"},
        "contentHash": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "capabilityDispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "disposition"],
        "properties": {
          "capability": {"type": "string"},
          "disposition": {"enum": ["SUPPORTED", "MAPPED", "TRANSFORMED", "CLIENT_BINDING_REQUIRED", "PARTIAL", "UNSUPPORTED_RUNTIME", "DEFERRED_RUNTIME_ENHANCEMENT"]},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "payload": {},
    "generatedAt": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
