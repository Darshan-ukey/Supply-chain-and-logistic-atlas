{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:execution:adapter-standard:v1",
  "title": "Atlas Runtime Adapter Standard V1",
  "type": "object",
  "required": ["adapterId", "runtime", "version", "capabilities", "operations"],
  "properties": {
    "adapterId": {"type": "string", "minLength": 1},
    "runtime": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "operations": {
      "type": "object",
      "required": ["assess", "requiredBindings", "project", "verify"],
      "properties": {
        "assess": {"const": true},
        "requiredBindings": {"const": true},
        "project": {"const": true},
        "verify": {"const": true},
        "compile": {"type": "boolean"},
        "materialize": {"type": "boolean"},
        "deploy": {"type": "boolean"},
        "status": {"type": "boolean"},
        "execute": {"type": "boolean"},
        "reconcileEvidence": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "dispositionVocabulary": {
      "type": "array",
      "items": {
        "enum": ["SUPPORTED", "MAPPED", "TRANSFORMED", "CLIENT_BINDING_REQUIRED", "PARTIAL", "UNSUPPORTED_RUNTIME", "DEFERRED_RUNTIME_ENHANCEMENT"]
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
