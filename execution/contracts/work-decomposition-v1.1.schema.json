{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:execution:work-decomposition:v1.1",
  "title": "Atlas Work Decomposition V1.1",
  "type": "object",
  "required": ["schemaVersion", "decompositionId", "parentA5", "elements", "lineage"],
  "properties": {
    "schemaVersion": {"const": "atlas-work-decomposition-v1.1"},
    "decompositionId": {"type": "string", "minLength": 1},
    "parentA5": {
      "type": "object",
      "required": ["moduleId", "moduleVersion", "processId"],
      "properties": {
        "moduleId": {"type": "string"},
        "moduleVersion": {"type": "string"},
        "processId": {"type": "string"},
        "contractId": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "purpose", "provenanceClass"],
        "properties": {
          "id": {"type": "string"},
          "type": {
            "enum": [
              "MANAGED_WORK", "DETERMINISTIC_VALIDATION", "DECISION", "SYSTEM_ACTION",
              "HUMAN_REVIEW", "DOCUMENT_INTERPRETATION", "WAIT_EVENT", "EXCEPTION_HANDLING",
              "ESCALATION", "RETRY", "RECOVERY", "EVIDENCE_PRODUCTION"
            ]
          },
          "purpose": {"type": "string"},
          "trigger": {"type": ["string", "null"]},
          "inputs": {"type": "array", "items": {"type": "string"}, "default": []},
          "decision": {"type": ["string", "null"]},
          "rule": {"type": ["string", "null"]},
          "control": {"type": ["string", "null"]},
          "action": {"type": ["string", "null"]},
          "systemInteraction": {"type": ["string", "null"]},
          "humanBoundary": {"type": ["string", "null"]},
          "outcomes": {"type": "array", "items": {"type": "string"}, "default": []},
          "next": {"type": "array", "items": {"type": "string"}, "default": []},
          "exception": {"type": ["string", "null"]},
          "evidence": {"type": ["string", "null"]},
          "provenanceClass": {"enum": ["SOURCE_BACKED", "ATLAS_DERIVED", "CLIENT_CONFIRMED", "RUNTIME_DERIVED"]},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNASSESSED"]}
        },
        "additionalProperties": true
      }
    },
    "lineage": {
      "type": "object",
      "required": ["generatedFromModuleId", "generatedFromModuleVersion", "generatedFromProcessId"],
      "properties": {
        "generatedFromModuleId": {"type": "string"},
        "generatedFromModuleVersion": {"type": "string"},
        "generatedFromProcessId": {"type": "string"},
        "sourceFoundationVersion": {"type": ["string", "null"]},
        "generatedAt": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
