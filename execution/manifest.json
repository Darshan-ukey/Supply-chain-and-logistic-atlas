{
  "architecture": "Atlas Execution Fabric Architecture V1",
  "status": "FROZEN",
  "build": "2.1.0-dev.1",
  "canonical": {
    "workDecomposition": "execution/contracts/work-decomposition-v1.1.schema.json",
    "runtimeAdapterStandard": "execution/contracts/execution-adapter-standard-v1.schema.json",
    "runtimeProjection": "execution/contracts/runtime-projection-v1.schema.json",
    "warehouse": "atlas_work_definitions + governed lineage/dependency model"
  },
  "flowGenerator": {
    "ui": "execution/ui/atlas-execution-flow.js",
    "style": "execution/ui/atlas-execution-flow.css",
    "views": ["CANONICAL", "RUNTIME_PROJECTION"],
    "representations": ["BPMN", "FLOW"],
    "exports": ["BPMN_2_XML", "SVG"],
    "pathGuards": {"maxVisitsPerNode": 2, "maxDepth": 64, "maxPaths": 1000}
  },
  "runtimeFamilies": [
    {
      "id": "malkom",
      "adapter": "execution/adapters/malkom/malkom-adapter.mjs",
      "adapterManifest": "execution/contracts/malkom-adapter-manifest-v1.json",
      "engineSuite": "execution/runtimes/malkom/engine-suite",
      "access": "CAPABILITY_GATED"
    }
  ],
  "guardrails": {
    "canonicalRuntimeNeutral": true,
    "runtimeArchitecturesIndependent": true,
    "runtimeGapNeverSilentlyFlattened": true,
    "flowGeneratedNotAuthored": true,
    "publicExecutionIpSanitized": true,
    "serverSideAuthorizationRequired": true
  }
}
