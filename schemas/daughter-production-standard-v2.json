{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/daughter-production-standard-v2.json",
  "title": "Atlas Daughter Production Standard V2",
  "type": "object",
  "required": [
    "module",
    "lineage",
    "tasks",
    "sourceRegistry",
    "validationProfile"
  ],
  "properties": {
    "module": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "status",
        "depth"
      ]
    },
    "lineage": {
      "type": "object",
      "required": [
        "parentModuleId",
        "parentVersion",
        "derivedFrom"
      ]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "sourceRegistry": {
      "type": "array"
    },
    "validationProfile": {
      "type": "object"
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "taskId",
        "title",
        "identity",
        "applicability",
        "requiredInformation",
        "decisionGates",
        "constraints",
        "controls",
        "atomicActions",
        "states",
        "branchTransitions",
        "temporalConstraints",
        "responsibility",
        "systemExchanges",
        "documents",
        "evidenceContracts",
        "expectedOutcomes",
        "clientBindingRequirements",
        "provenanceClaims",
        "executability"
      ]
    },
    "binding": {
      "type": "object",
      "required": [
        "bindingId",
        "bindingObject",
        "bindingType",
        "requiredWhen",
        "why",
        "valueOrigin",
        "validation",
        "sourceRefs",
        "basis",
        "systemOfRecord",
        "clientFieldMapping",
        "authorityOwner",
        "collectionQuestion",
        "resolutionStatus"
      ]
    }
  }
}
