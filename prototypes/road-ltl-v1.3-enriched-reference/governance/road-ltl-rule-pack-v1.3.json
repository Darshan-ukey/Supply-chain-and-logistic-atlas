        ]
      },
      "otherwise": "MODEL_EVIDENCE"
    },
    {
      "sourceIds": [
        "src-iso14083"
      ],
      "candidateWhen": {
        "lens": "ecl-y"
      },
      "otherwise": "AVAILABLE_NOT_CURRENTLY_ACTIVE"
    }
  ],
  "responsibilityOverlayRules": {
    "contract-direct-carriage": {
      "physical": "actor-operating-carrier PERFORMS/HAS_CUSTODY/OWNS",
      "customer": "actor-operating-carrier RECEIVES_OUTPUT",
      "financial": [
        "actor-operating-carrier BILLS",
        "actor-shipper PAYS"
      ]
    },
    "contract-forwarder-arranged": {
      "orchestrator": "actor-forwarder ARRANGES/OBSERVES (+OWNS for customer-facing tasks)",
      "physical": "actor-operating-carrier PERFORMS/HAS_CUSTODY",
      "financial": "actor-forwarder BILLS/PAYS contract-dependent"
    },
    "contract-managed-logistics": {
      "orchestrator": "actor-3pl or actor-4pl ARRANGES/OWNS/OBSERVES (+ESCALATES for non-standard paths)",
      "physical": "actor-operating-carrier PERFORMS/HAS_CUSTODY",
      "financial": "orchestrator BILLS/PAYS contract-dependent"
    }
  },
  "migrationNote": "Eligibility option rules remain represented by the existing per-process applicability matrices and the V1.2 standalone UI until the generic daughter composer consumes this rule pack. No behavior has been switched in V1.3."
}