        "control",
        "decisionAuthority"
      ],
      "pattern": "approv",
      "hypothesis": "Fixture hypothesis: an explicit approval gate may introduce control latency.",
      "candidates": [
        "Approval workflow",
        "Policy/rules engine"
      ]
    },
