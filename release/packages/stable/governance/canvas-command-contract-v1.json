{
  "schemaVersion": "atlas-canvas-command-v1",
  "principle": "LLM may propose commands. Deterministic Atlas code validates and executes them.",
  "commands": {
    "activate_module": {"required": ["moduleId"]},
    "reset_universe": {"required": []},
    "set_semantic_level": {"required": ["level"], "allowedLevels": [0,1,2,3]},
    "select_process": {"required": ["processId"]},
    "playback": {"required": ["action"], "allowedActions": ["start","pause","freeze","step_forward","step_back","exit"]},
    "set_follow_signal": {"required": ["signal"], "allowedSignals": ["all","physical","information","data","financial","control"]},
    "trace_object": {"required": ["objectId"]},
    "open_source": {"required": ["sourceId"]},
    "open_lens": {"required": ["lens"], "allowedLenses": ["actors","systems","controls","sources"]},
    "set_context_option": {"required": ["dimension","optionId"], "allowedDimensions": ["role","movement","node","jurisdiction","regime","condition","contract"]},
    "clear_context": {"required": []},
    "enter_transform": {"required": []},
    "open_findings": {"required": []},
    "open_opportunities": {"required": []}
  }
}
