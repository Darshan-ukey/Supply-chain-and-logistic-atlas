{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-data-contract-v1.0.schema.json",
  "title": "Supply Chain Atlas Child Module Data Contract v1.0",
  "type": "object",
  "required": [
    "contractVersion",
    "module",
    "a3Parents",
    "processes",
    "processFlowEdges",
    "executionTransitions",
    "ontologyNodes",
    "ontologyEdges",
    "sources",
    "availableContext"
  ],
  "properties": {
    "contractVersion": {
      "const": "atlas-data-contract-v1.0"
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "status",
        "depth"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string"
        },
        "depth": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "publication": {
      "type": "object",
      "properties": {
        "parentModuleId": {
          "type": "string"
        },
        "parentVersion": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "a3Parents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "page0DomainId",
          "childProcessIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "page0DomainId": {
            "type": "string"
          },
          "childProcessIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "a3ParentId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "a3ParentId": {
            "type": "string"
          },
          "pathType": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array"
          },
          "outputs": {
            "type": "array"
          },
          "participants": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "processFlowEdges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "type",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "executionTransitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "processId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "processId": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "ontologyNodes": {
      "type": "array"
    },
    "ontologyEdges": {
      "type": "array"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "issuer",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "lenses": {
      "type": "array"
    },
    "childActors": {
      "type": "array"
    },
    "availableContext": {
      "type": "object",
      "required": [
        "roles",
        "movements",
        "nodes",
        "jurisdictions",
        "regimes",
        "conditions",
        "contracts"
      ],
      "additionalProperties": true
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "module": {
            "properties": {
              "depth": {
                "const": "A5_VERIFIED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "processes": {
            "minItems": 1
          },
          "a3Parents": {
            "minItems": 1
          },
          "sources": {
            "minItems": 1
          }
        }
      }
    }
  ]
}