{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"enterprise-module-contract-v1.schema.json",
  "title":"Enterprise Operations Module Contract v1.0",
  "type":"object",
  "required":["contractVersion","domainPackId","module","a3Parents","processes","processFlowEdges","sources"],
  "properties":{
    "contractVersion":{"const":"enterprise-operations-module-v1.0"},
    "domainPackId":{"type":"string","minLength":1},
    "module":{"type":"object","required":["id","name","version","status","depth"],"additionalProperties":true},
    "a3Parents":{"type":"array","items":{"type":"object","required":["id","label","territoryId","childProcessIds"],"additionalProperties":true}},
    "processes":{"type":"array","items":{"type":"object","required":["id","label","a3ParentId"],"additionalProperties":true}},
    "processFlowEdges":{"type":"array","items":{"type":"object","required":["id","from","type","to"],"additionalProperties":true}},
    "executionTransitions":{"type":"array"},
    "ontologyNodes":{"type":"array"},
    "ontologyEdges":{"type":"array"},
    "sources":{"type":"array"},
    "availableContext":{"type":"object"},
    "extensions":{"type":"object"},
    "fixture":{"type":"object"}
  },
  "additionalProperties":true
}
