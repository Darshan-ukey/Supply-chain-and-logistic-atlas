{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-state-contract-v1",
  "title": "Typed Document / Legal State Contract v1",
  "type": "object",
  "required": [
    "documentId",
    "documentType",
    "state"
  ],
  "properties": {
    "documentId": {
      "type": "string"
    },
    "documentType": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "state": {
      "enum": [
        "DRAFT",
        "ISSUED",
        "AMENDED",
        "ORIGINAL",
        "COPY",
        "ELECTRONIC",
        "TRANSFERABLE",
        "NEGOTIABLE",
        "SURRENDERED",
        "RELEASED",
        "CANCELLED",
        "OTHER"
      ]
    },
    "legalState": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "issuerActorId": {
      "type": "string"
    },
    "holderActorId": {
      "type": "string"
    },
    "relatedDocumentIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
