{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temporal-constraint-contract-v1",
  "title": "Temporal Constraint Contract v1",
  "type": "object",
  "required": [
    "id",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "CUT_OFF",
        "DEADLINE",
        "VALIDITY",
        "FREE_TIME",
        "DWELL",
        "CONNECTION_WINDOW",
        "RESPONSE_CLOCK",
        "SLA",
        "SCHEDULE",
        "OTHER"
      ]
    },
    "trigger": {
      "type": "string"
    },
    "start": {
      "type": "string"
    },
    "end": {
      "type": "string"
    },
    "duration": {
      "type": "number"
    },
    "unit": {
      "enum": [
        "SECOND",
        "MINUTE",
        "HOUR",
        "DAY",
        "BUSINESS_DAY",
        "OTHER"
      ]
    },
    "timezone": {
      "type": "string"
    },
    "condition": {
      "type": "string"
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rawText": {
      "type": "string"
    },
    "normalizationStatus": {
      "type": "string"
    }
  }
}
