{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "measurement-contract-v1",
  "title": "KPI / Measurement Contract v1",
  "type": "object",
  "required": [
    "metricId",
    "name",
    "measureType"
  ],
  "properties": {
    "metricId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "measureType": {
      "enum": [
        "COUNT",
        "RATE",
        "DURATION",
        "COST",
        "REVENUE",
        "QUALITY",
        "SERVICE",
        "RISK",
        "SUSTAINABILITY",
        "OTHER"
      ]
    },
    "unit": {
      "type": "string"
    },
    "formula": {
      "type": "string"
    },
    "target": {},
    "observationSource": {
      "type": "string"
    },
    "processIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcomeIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effectiveFrom": {
      "type": [
        "string",
        "null"
      ]
    },
    "effectiveTo": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
