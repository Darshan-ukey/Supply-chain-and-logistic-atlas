# v1.1.6 release controls
# stable | lab
ATLAS_RELEASE_CHANNEL=lab
ATLAS_RELEASE_ID=supply-chain-atlas-v2-execution-intelligence-2026.08.26
ATLAS_REQUIRE_LLM=false
ATLAS_DEPENDENCY_TIMEOUT_MS=2500

# Stage 17 production boundary
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# V2 protected execution-definition API only. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated Admin email allowlist. Supabase app_metadata atlas_role=admin is also supported.
ATLAS_ADMIN_EMAILS=admin@example.com

# Stage 18 provider-agnostic Ask Atlas gateway.
# Pilot document structuring is configured below to allow only the approved provider.
# Keep every credential server-side.
# Supported: gemini | openai | anthropic | openai-compatible | none
ATLAS_LLM_PROVIDER=gemini
ATLAS_LLM_API_KEY=
ATLAS_LLM_MODEL=
ATLAS_LLM_BASE_URL=

# Stage 22.2 — session-ephemeral client-document policy.
# Messy RFP/SOP text is structured by the approved LLM, then mapped/validated
# against Atlas IDs/rules. The Atlas application does not retain source bytes,
# parsed text, chunks, embeddings or unconfirmed candidate rows.
ATLAS_EPHEMERAL_DOCUMENTS=true
ATLAS_EPHEMERAL_DOCUMENT_LLM=true
ATLAS_EPHEMERAL_DOCUMENT_REQUIRE_LLM=true
# Set true only after the account/project has been reviewed for the intended
# confidential pilot use and provider logging/data-sharing settings are acceptable.
ATLAS_EPHEMERAL_DOCUMENT_PROVIDER_APPROVED=false
ATLAS_EPHEMERAL_DOCUMENT_ALLOWED_PROVIDERS=gemini

# Stage 23 pilot quality gate. Keep false until the synthetic live-provider corpus passes.
ATLAS_PILOT_LIVE_EVAL_PASSED=false

# Atlas V2.1 capability bootstrap (optional; prefer app_metadata/database grants long-term)
ATLAS_MALKOM_EMAILS=
ATLAS_MALKOM_VIEW_EMAILS=
ATLAS_MALKOM_CONFIGURE_EMAILS=
ATLAS_MALKOM_COMPILE_EMAILS=
ATLAS_MALKOM_MATERIALIZE_EMAILS=
ATLAS_MALKOM_OPERATE_EMAILS=
