# v1.1.8 release controls
# stable | lab
ATLAS_RELEASE_CHANNEL=lab
ATLAS_RELEASE_ID=scoip-v1.1.8-governed-composition-2026.08.25
ATLAS_REQUIRE_LLM=false
ATLAS_DEPENDENCY_TIMEOUT_MS=2500

# Stage 17 production boundary
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Stage 18 provider-agnostic Ask Atlas gateway.
# Keep every credential server-side.
# Supported: gemini | openai | anthropic | openai-compatible | none
ATLAS_LLM_PROVIDER=gemini
ATLAS_LLM_API_KEY=
ATLAS_LLM_MODEL=
ATLAS_LLM_BASE_URL=

# Stage 22.2 — session-ephemeral client-document policy.
ATLAS_EPHEMERAL_DOCUMENTS=true
ATLAS_EPHEMERAL_DOCUMENT_LLM=true
ATLAS_EPHEMERAL_DOCUMENT_REQUIRE_LLM=true
ATLAS_EPHEMERAL_DOCUMENT_PROVIDER_APPROVED=false
ATLAS_EPHEMERAL_DOCUMENT_ALLOWED_PROVIDERS=gemini

# Stage 23 pilot quality gate.
ATLAS_PILOT_LIVE_EVAL_PASSED=false
