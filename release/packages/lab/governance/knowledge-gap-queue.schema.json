{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-knowledge-gap-queue-v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "atlas-knowledge-gap-queue-v1.0"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "moduleId",
          "createdAt",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "INSUFFICIENT_APPLICABILITY_EVIDENCE",
              "MISSING_RELATIONSHIP",
              "MISSING_COMPATIBILITY_RULE",
              "MISSING_A5_DETAIL",
              "DEPTH_MISMATCH",
              "SOURCE_CONFLICT"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "RESEARCHING",
              "VALIDATED",
              "RESOLVED",
              "REJECTED"
            ]
          },
          "moduleId": {
            "type": "string"
          },
          "context": {
            "type": "object"
          },
          "basis": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "affectedProcessIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}